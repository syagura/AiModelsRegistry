@model AiModelRegistry.Models.AiModel

@{
    ViewData["Title"] = "Model Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h4>🔍 AI Model Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4 fw-bold">Model Name</dt>
                        <dd class="col-sm-8">@Model.ModelName</dd>

                        <dt class="col-sm-4 fw-bold">Version</dt>
                        <dd class="col-sm-8">@Model.Version</dd>

                        <dt class="col-sm-4 fw-bold">Algorithm</dt>
                        <dd class="col-sm-8">@Model.Algorithm</dd>

                        <dt class="col-sm-4 fw-bold">Accuracy (%)</dt>
                        <dd class="col-sm-8">@Model.Accuracy%</dd>

                        <dt class="col-sm-4 fw-bold">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge 
                                @(Model.Status == "Production" ? "bg-success" : 
                                  Model.Status == "Experimental" ? "bg-warning text-dark" : "bg-secondary")">
                                @Model.Status
                            </span>
                        </dd>

                        <dt class="col-sm-4 fw-bold">Description</dt>
                        <dd class="col-sm-8">@Model.Description</dd>

                        <dt class="col-sm-4 fw-bold">Created Date</dt>
                        <dd class="col-sm-8">@Model.CreatedDate.ToString("dd MMM yyyy")</dd>
                    </dl>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="Index" class="btn btn-secondary">← Back</a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">✏️ Edit</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>