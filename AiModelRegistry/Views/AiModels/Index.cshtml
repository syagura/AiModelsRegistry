@model IEnumerable<AiModelRegistry.Models.AiModel>

@{
    ViewData["Title"] = "AI Model Registry";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>AI Model Registry</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add New Model</a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Model Name</th>
                <th>Version</th>
                <th>Algorithm</th>
                <th>Accuracy (%)</th>
                <th>Status</th>
                <th>Created Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ModelName</td>
                    <td>@item.Version</td>
                    <td>@item.Algorithm</td>
                    <td>@item.Accuracy</td>
                    <td>
                        <span class="badge 
                            @(item.Status == "Production" ? "bg-success" : 
                              item.Status == "Experimental" ? "bg-warning text-dark" : "bg-secondary")">
                            @item.Status
                        </span>
                    </td>
                    <td>@item.CreatedDate.ToString("dd MMM yyyy")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detail</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>